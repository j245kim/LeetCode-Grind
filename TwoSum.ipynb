   "source": [
    "def twoSum(self, nums: list[int], target: int) -> list[int]:\n",
    "    length = len(nums)\n",
    "    end_pointer = length - 1\n",
    "\n",
    "    for i in range(length):\n",
    "        for j in range(end_pointer, -1, -1):\n",
    "            if i != j and nums[i] + nums[j] == target:\n",
    "                return [i, j]"
   ]
  }
